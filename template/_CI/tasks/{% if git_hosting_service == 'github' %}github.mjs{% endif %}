/** GitHub-specific helpers for the release flow. */

import { capture, stripCredentials, which } from './shared.mjs';

/** Derive the https://github.com/<owner>/<repo> web URL from the origin remote. */
function originWebUrl() {
  const remote = capture('git remote get-url origin');
  if (!remote.ok) {
    return '';
  }
  // CI rewrites origin to embed a token (https://x-access-token:<token>@github.com/…);
  // that must not leak into a printed or published URL.
  const url = stripCredentials(remote.stdout.trim());
  const sshMatch = /^git@([^:]+):(.+?)(\.git)?$/.exec(url);
  if (sshMatch) {
    return `https://${sshMatch[1]}/${sshMatch[2]}`;
  }
  return url.replace(/\.git$/, '');
}

/**
 * Open a release pull request with the `gh` CLI when available.
 * Returns the PR URL, or an empty string when gh is missing or fails.
 */
export function createReleasePr(releaseBranch, newVersion) {
  if (!which('gh')) {
    console.log('gh CLI not found — skipping automatic pull request creation.');
    return '';
  }
  const result = capture(
    `gh pr create --base main --head ${releaseBranch} ` +
      `--title "chore(release): v${newVersion}" ` +
      `--body "Automated release PR for v${newVersion}. Merging publishes the release from CI."`,
  );
  if (!result.ok) {
    console.log('gh pr create failed:');
    console.log(result.stderr.trim());
    return '';
  }
  return result.stdout.trim();
}

/** Build the manual compare/PR-creation URL for the release branch. */
export function prCreateUrl(releaseBranch) {
  const base = originWebUrl();
  if (!base) {
    return '';
  }
  return `${base}/compare/main...${releaseBranch}?expand=1`;
}
